# انسخ هذا الملف إلى ".env" بجانب server.py ثم عدّل القيم. لا تضع أسرارًا حقيقية في هذا الملف.
# رمز إنشاء حسابات المدير (أنت تحدده وتعطيه لمن تريد). بدونه لا أحد يستطيع إنشاء حساب.
MASAR_ACCESS_CODE=
MASAR_HOST=0.0.0.0
MASAR_PORT=8787
# رمز الدولة لتحويل الأرقام المحلية (0926...) إلى دولية. ليبيا=218
MASAR_COUNTRY_CODE=218
# كل كم يوم يُعاد تنبيه القسط المتأخر (0 = مرة واحدة فقط)
MASAR_OVERDUE_REMINDER_DAYS=7

# ---- واتساب Cloud API (الإرسال) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# قالب معتمد من Meta، جسمه متغير واحد فقط {{1}} (يحمل نص الرسالة)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
# template (الافتراضي) أو text (يعمل فقط خلال 24 ساعة من رد ولي الأمر)
WHATSAPP_MODE=template

# ---- واتساب (الاستقبال: Webhook) ----
# أي نص سري تختاره، تكتبه نفسه في لوحة Meta عند تسجيل الـ Webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret من لوحة تطبيق Meta (للتحقق من توقيع الرسائل الواردة)
WHATSAPP_APP_SECRET=
